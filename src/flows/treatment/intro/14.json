{
    "header_text": "Mental Health and Treatment Questionnaire",
    "header_icon": "assets/subtitle.png",
    "elements": [
        {
            "type": "Text",
            "text": "In the past, have you ever received any help for issues related to mental health? Please select all that apply."
        },
        {
            "type": "Buttons",
            "buttons": [
                "1::Therapy (talking with a trained professional)",
                "2::Prescription medications ",
                "3::Seeking social support (e.g. from friends",
                "teachers",
                "parents",
                "etc)",
                "4::Self-guided help (e.g. from books",
                "social media",
                "apps)",
                "5::!Other",
                "6::^I have not recevied help",
                "7::^Prefer not to answer"
            ],
            "selectable": true,
            "multiselect": true,
            "variable_name": "2"
        }
    ]
}